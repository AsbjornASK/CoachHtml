{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|@|src/|node_modules/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/cron-morning.mjs": {
      "includeFiles": "static/js/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron-morning",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
